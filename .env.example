# ─────────────────────────────────────────────
# Nuvra — environment configuration
# Copy to .env and fill in your values.
# NEVER commit .env.
# ─────────────────────────────────────────────

# Database — SQLite file. Local: ./nuvra.db. Production: a path on a persistent
# volume, e.g. /data/nuvra.db (see docs/DEPLOYMENT.md). Pending migrations are
# applied automatically when the server starts (set AUTO_MIGRATE=false to opt out).
DATABASE_URL="./nuvra.db"
# AUTO_MIGRATE="true"

# First administrator — provisioned at boot ONLY while no admin exists
# (creates the account + the platform workspace; promotes the account if the
# email already exists). Min 12 characters. Safe to leave in place afterwards.
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="a-long-passphrase-of-your-own"
# ADMIN_NAME="Your Name"

# HTTP port (Railway/Render/Fly inject it) — default 3000
# PORT="3000"

# Session security — generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"

# Base URL of the deployment (used in links, emails, webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Stripe (payments) ───────────────────────
# When absent, Nuvra runs in explicit TEST MODE (no real money moves).
# STRIPE_SECRET_KEY="sk_live_..." or "sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PUBLISHABLE_KEY="pk_..."

# ── Email provider (optional) ───────────────
# Without a provider, Nuvra uses its built-in OUTBOX (emails stored and
# visible in Admin → Emails, clearly marked as not delivered).
# RESEND_API_KEY="re_..."
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="Nuvra <no-reply@nuvra.app>"

# ── Nuvra AI (optional) ─────────────────────
# OpenAI-compatible provider. Without it, AI features show "provider required".
# AI_PROVIDER="openai"
# AI_API_KEY="sk-..."
# AI_MODEL="gpt-4o-mini"

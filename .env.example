# ─────────────────────────────────────────────
# Nuvra — environment configuration
# Copy to .env and fill in your values.
# NEVER commit .env.
# ─────────────────────────────────────────────

# ── Database ────────────────────────────────
# Nuvra speaks libSQL: a local SQLite file by default, or a hosted database
# (Turso) when a connection string is set — required on Vercel, which has no disk.
# Pending migrations are applied by `npm run db:migrate` (and automatically at
# server boot; set AUTO_MIGRATE=false to opt out).

# Local file (development, Docker, tests) — default is ./nuvra.db
DATABASE_URL="./nuvra.db"
# AUTO_MIGRATE="true"

# Hosted libSQL / Turso (production): create one with `turso db create nuvra`
# and paste `turso db show nuvra --url` / `turso db tokens create nuvra`.
# DATABASE_URL + DATABASE_AUTH_TOKEN are accepted aliases, and the variables
# created by the Vercel Marketplace Turso integration (STORAGE_TURSO_*) are
# detected automatically.
# TURSO_DATABASE_URL="libsql://nuvra-<org>.turso.io"
# TURSO_AUTH_TOKEN="eyJ..."

# ── First administrator ─────────────────────
# Provisioned while no admin exists (creates the account + the platform
# workspace; promotes the account if the email already exists).
# Password: min 12 characters. Safe to leave in place afterwards.
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="a-long-passphrase-of-your-own"
# ADMIN_NAME="Your Name"

# ── HTTP ────────────────────────────────────
# Port (Railway/Render/Fly inject it) — default 3000
# PORT="3000"

# Base URL of the deployment (links, emails, Stripe redirects).
# On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Cron ────────────────────────────────────
# Protects POST /api/cron/process (scheduled emails, paused automations).
# Required in production; the endpoint refuses to run without it.
# Generate with: openssl rand -hex 32
# CRON_SECRET=""

# ── Stripe (payments) ───────────────────────
# When absent, Nuvra runs in explicit TEST MODE (no real money moves).
# STRIPE_SECRET_KEY="sk_live_..." or "sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PUBLISHABLE_KEY="pk_..."
# STRIPE_PRICE_PRO="price_..."
# STRIPE_PRICE_BUSINESS="price_..."

# ── Email provider (optional) ───────────────
# Without a provider, Nuvra uses its built-in OUTBOX (emails stored and
# visible in Admin → Emails, clearly marked as not delivered).
# RESEND_API_KEY="re_..."
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="Nuvra <no-reply@nuvra.app>"

# ── Nuvra AI (optional) ─────────────────────
# OpenAI-compatible provider. Without it, AI features show "provider required".
# AI_PROVIDER="openai"
# AI_API_KEY="sk-..."
# AI_MODEL="gpt-4o-mini"
